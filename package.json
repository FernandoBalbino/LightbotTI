{
  "name": "lightbot-ti",
  "version": "1.0.0",
  "description": "Desafio do Robô: informática e programação nos 16 mapas originais do Lightbot.",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^26.12.1"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.offline.config.mjs && node scripts/build-offline.mjs dist",
    "build:web": "vite build --outDir dist-web && node scripts/build-offline.mjs dist-web",
    "preview": "vite preview",
    "clean": "rimraf dist dist-web",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "validate:placements": "node scripts/generate-placements.mjs",
    "qa:browser": "node scripts/check-browser.mjs",
    "preview:web": "vite preview --outDir dist-web --host 127.0.0.1 --port 43861"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "eslint": "10.13.0",
    "playwright": "^1.56.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FernandoBalbino/LightbotTI.git"
  },
  "bugs": {
    "url": "https://github.com/FernandoBalbino/LightbotTI/issues"
  },
  "homepage": "https://fernandobalbino.github.io/LightbotTI/",
  "dependencies": {
    "i18next": "^26.5.6",
    "sortablejs": "^1.15.6",
    "theme-change": "^3.0.4"
  },
  "type": "module"
}
